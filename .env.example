# Copy this file to .env (or enter these in your host's settings page). Never commit .env.

# Your real cell phone, the one people call. Digits only is fine.
OWNER_PHONE=2055550100
# The Plivo number you rented. Your phone forwards unanswered calls here.
SERVICE_NUMBER=2055550199
# The code you give to people you want to reach you (2 to 8 digits).
GATE_CODE=4321
# The public web address where this server runs, no slash at the end.
BASE_URL=https://your-app.example.com
# From your Plivo console (Account > Auth Token). Used to check that calls really come from Plivo.
PLIVO_AUTH_TOKEN=replace-me

# Optional
GREETING=You have reached Pat.
# Seconds to ring your phone. Keep it SHORTER than your carrier's ring time, or your carrier voicemail answers first.
RING_SECONDS=18
# Seconds the gate waits for the code, 5 to 60. Leave room for the greeting to play.
PROMPT_SECONDS=30
MAX_MESSAGE_SECONDS=120
# Voicemail alerts to your phone through the free ntfy app. Pick a long, random topic name.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# One number per line. Defaults to whitelist.txt next to package.json.
WHITELIST_FILE=
