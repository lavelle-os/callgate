# Settings. On Railway these go in the service's Variables tab. For local testing, copy this
# file to .env and run `npm run dev` (which reads it). Never commit .env.

# Your real cell phone, the one people call. 10 digits, US only.
OWNER_PHONE=2055550100
# The Plivo number you rented. Your phone forwards unanswered calls here.
SERVICE_NUMBER=2055550199
# The code you give to people you want to reach you: 4 to 8 digits, not a run or a repeat.
# The server refuses to start until you change this line.
GATE_CODE=choose-4-to-8-digits
# The word the gate says to you, and only you, when it rings you: "Call from your gate.
# <your word>. Press 1 to take it." One or two plain words, letters only. It never goes in an
# alert, a log or a URL. A call from the Gate contact that does not open with it is not the gate.
OWNER_WORD=choose-a-word
# The public https address of this server, with nothing after the host and no slash at the end.
# It must match the answer URL in the Plivo console character for character.
BASE_URL=https://your-app.example.com
# Plivo console, overview page: the Auth Token (not the Auth ID). If your number sits in a
# subaccount, use that subaccount's token.
PLIVO_AUTH_TOKEN=replace-me
# Alerts (voicemails, transcripts, rings, wrong codes) go to the free ntfy app. Required: it is
# the only way you learn a voicemail arrived. On ntfy.sh the topic name is the ONLY secret:
# make it at least 16 random characters (openssl rand -hex 16) and subscribe to it in the app.
NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic

# Optional
GREETING=You have reached Pat.
VOICE=WOMAN
# Seconds to ring your phone when the gate passes a call to you, 5 to 120. Keep it at least
# 5 seconds SHORTER than your carrier's own no-answer time (measured in setup step 4),
# or your carrier forwards the gate's own ring back to the gate.
RING_SECONDS=15
# Seconds the gate waits for the code, 5 to 60. Plivo's pages do not say whether the timer
# starts with the prompt or after it, so the default leaves room for the prompt itself.
PROMPT_SECONDS=20
# Seconds of silence that end a voicemail recording, 2 to 60.
SILENCE_SECONDS=10
# Longest voicemail, in seconds.
MAX_MESSAGE_SECONDS=120
# Longest bridged call, in seconds (Plivo's default is 4 hours; this caps the cost).
MAX_CALL_SECONDS=1800
# Calls accepted per hour from one number, and from everyone. 0 turns a cap off. Known callers
# count per number but not against the total, so a flood of strangers cannot lock them out.
CALLS_PER_HOUR_PER_CALLER=6
CALLS_PER_HOUR=60
# How many times the gate may ring you in an hour, all paths together, and how many times a
# day one number may ring you by staying silent after the tone (the path that needs no code).
# Over budget, callers get voicemail and you get one alert. 0 turns a budget off.
RINGS_PER_HOUR=10
SILENT_RINGS_PER_DAY=1
# When the gate rings you, you hear your word and press 1 to take the call. This keeps your
# own carrier voicemail from taking the call instead of you. Set to false to connect at once
# (then there is no word and no proof the call came through the gate).
SCREEN_OWNER_RING=true
# A whitelisted number still presses one key before it rings you. That stops recorded
# robocalls wearing a friend's number, which send no tones. It does not stop a person.
# Set to false to skip the key for everyone, or add "!" to one entry in WHITELIST.
WHITELIST_PRESS_KEY=true
# A heads-up alert every time the gate rings you. The proof of a real ring is the word.
RING_ALERT=true
# Send an alert when someone enters a wrong code.
ALERT_ON_CODE=true
# Optional ntfy access token (self-hosted ntfy or a paid ntfy.sh account).
NTFY_TOKEN=
# Send one "callgate started" alert at startup, to prove the alert path without a phone call.
STARTUP_ALERT=true

# People who skip the code: numbers separated by commas. Each may carry a label after "=",
# and "!" at the end rings straight through with no key press (for a pharmacy's automated call or an
# alarm company that cannot press one):
#   WHITELIST=2055550111=Mom, 2055550122=Pharmacy!, 2055550133
# This is the way to do it on a host like Railway, where whitelist.txt never arrives.
WHITELIST=
# Or a file with one entry per line (local use).
WHITELIST_FILE=

# Only for local testing on your own computer. With this off the server refuses to listen on
# anything but 127.0.0.1.
# CHECK_SIGNATURES=false
